# ============================================================
# TESSERACT .gitignore
# ============================================================

# ---- Secrets & Environment Variables ----
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/*/.*
!env/*/.env.example
*.whl

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ---- VS Code Extension ----
*.vsix
out/
.vscode-test/

# ---- Firefox Extension ----
*.xpi
web-ext-artifacts/

# ---- SQLite Databases (user data) ----
*.db
*.sqlite
*.sqlite3

# ---- Ollama / AI Models (large files) ----
models/
*.gguf
*.onnx
*.safetensors
*.bin

# ---- OCR / Media ----
*.tiff
*.bmp

# ---- IDE & OS ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Test & Coverage ----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
